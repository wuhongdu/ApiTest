{
  "name": "apitest",
  "version": "0.2.0",
  "private": true,
  "description": "ApiTest - desktop API debugger powered by Tauri",
  "scripts": {
    "dev:web": "npm run dev --prefix vue-element-admin",
    "build:web": "npm run build:prod --prefix vue-element-admin",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:rust && npm run test:unit",
    "test:rust": "cd src-tauri && cargo test -- --nocapture",
    "test:unit": "npm run test:unit --prefix vue-element-admin -- --testPathPattern=scriptRunner"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
