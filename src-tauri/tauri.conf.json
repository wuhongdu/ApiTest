{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApiTest",
  "version": "0.2.0",
  "identifier": "com.apitest.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix vue-element-admin",
    "devUrl": "http://localhost:9527",
    "beforeBuildCommand": "npm run build:prod --prefix vue-element-admin",
    "frontendDist": "../vue-element-admin/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ApiTest",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
